universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/rsr_generation/hpc/run.sh

# Five base-prompt types, 75 candidates each. Output is isolated from the
# frozen train lineage under ../splits/dev/results/.
environment = "SAMPLE=../splits/dev/samples/dev_base.tsv RESULTS_DIR=../splits/dev/results CONFIG=../splits/dev/config.json TAG=dev_base DOCS=prompts/base WORKERS=16 TOOL_MODE=auto TOOL_PARSER=muse_glimmer REASONING_PARSER=muse_glimmer"

output = /scratch/hongxuzhou/logs/llm_gen/dev_base.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/dev_base.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/dev_base.$(ClusterId).log

request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 86400

queue 1
