universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/llm_gen_playground/hpc/run.sh

# Round 2: 50 documents per type (350), none from round 1, base repairs only,
# prompt documents with `?`, token limit 32768. Results go to
# results/meta-models_Muse-Glimmer-30B.r2.tsv; resumable.
# 16 workers: all items share the ~22k-token prompt in the prefix cache, so
# the KV cache holds them comfortably (681k tokens in round 1).
environment = "SAMPLE=pinned_sample_r2.tsv TAG=r2 WORKERS=16 TOOL_MODE=auto TOOL_PARSER=muse_glimmer REASONING_PARSER=muse_glimmer"

output = /scratch/hongxuzhou/logs/llm_gen/r2.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/r2.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/r2.$(ClusterId).log

request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 86400

queue 1
