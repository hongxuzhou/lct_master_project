universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/llm_gen_playground/hpc/run.sh

# Round 3, edge label only: 50 documents of sample_r3_edge.tsv under the new
# site definition (README "Full run on train"), with prompt_docs_edge_r3/
# (§4.4 rewritten; everything else as prompt_docs/). Results go to
# results/meta-models_Muse-Glimmer-30B.r3_edge.tsv; resumable.
environment = "SAMPLE=sample_r3_edge.tsv TAG=r3_edge DOCS=prompt_docs_edge_r3 WORKERS=16 TOOL_MODE=auto TOOL_PARSER=muse_glimmer REASONING_PARSER=muse_glimmer"

output = /scratch/hongxuzhou/logs/llm_gen/r3_edge.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/r3_edge.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/r3_edge.$(ClusterId).log

request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 86400

queue 1
