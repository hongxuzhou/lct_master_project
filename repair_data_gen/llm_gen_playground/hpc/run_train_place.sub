universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/llm_gen_playground/hpc/run.sh

# Edge label, places (decided 2026-10-10): documents whose only edge-label
# sites are places (select_docs.py --edge-sites place; documents used once
# for another type may be drawn again), with prompt_docs_edge_r4/ (§4.4
# third kind, sha256 24c14008...). Results go to
# results/meta-models_Muse-Glimmer-30B.train_place.tsv; resumable. About 3 h
# at 16 workers (627 documents; train_edge took about 2 h for 403).
environment = "SAMPLE=sample_train_place.tsv TAG=train_place DOCS=prompt_docs_edge_r4 WORKERS=16 TOOL_MODE=auto TOOL_PARSER=muse_glimmer REASONING_PARSER=muse_glimmer"

output = /scratch/hongxuzhou/logs/llm_gen/train_place.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/train_place.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/train_place.$(ClusterId).log

request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 86400

queue 1
