universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/llm_gen_playground/hpc/run.sh

# Smoke test: 3 items, separate results file (results/<model>.smoke.tsv).
# Fill TOOL_PARSER / REASONING_PARSER from the setup log if it listed any.
environment = "TAG=smoke LIMIT=3 WORKERS=3 TOOL_MODE=text"

output = /scratch/hongxuzhou/logs/llm_gen/smoke.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/smoke.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/smoke.$(ClusterId).log

# BF16 weights are ~60 GB: one H100 or A100 80GB.
request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 7200

queue 1
