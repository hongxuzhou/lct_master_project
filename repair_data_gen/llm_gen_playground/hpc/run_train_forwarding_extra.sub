universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/llm_gen_playground/hpc/run.sh

# Forwarding on train, toward ~500 items (2026-10-10): 185 documents never
# drawn before (sample_train_forwarding_extra.tsv), prompt_docs/ unchanged
# (sha256 6b17847a, as the full run), so the items pool with the first 333.
# Results go to results/meta-models_Muse-Glimmer-30B.train_forwarding_extra.tsv;
# resumable. About 1 h at 16 workers.
environment = "SAMPLE=sample_train_forwarding_extra.tsv TAG=train_forwarding_extra DOCS=prompt_docs WORKERS=16 TOOL_MODE=auto TOOL_PARSER=muse_glimmer REASONING_PARSER=muse_glimmer"

output = /scratch/hongxuzhou/logs/llm_gen/train_forwarding_extra.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/train_forwarding_extra.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/train_forwarding_extra.$(ClusterId).log

request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 86400

queue 1
