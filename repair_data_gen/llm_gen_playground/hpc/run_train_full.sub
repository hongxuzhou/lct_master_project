universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/llm_gen_playground/hpc/run.sh

# Full run on train, six types (all but edge label): 5,993 documents of
# sample_train_full.tsv, prompt_docs/ as validated in round 2 (the run
# records its sha256 in run_meta). Results go to
# results/meta-models_Muse-Glimmer-30B.train_full.tsv; resumable.
# About 30 h at 16 workers (round 2: median 4 min an item); batch jobs may
# run up to a week, so the limit is set to 4 days.
environment = "SAMPLE=sample_train_full.tsv TAG=train_full DOCS=prompt_docs WORKERS=16 TOOL_MODE=auto TOOL_PARSER=muse_glimmer REASONING_PARSER=muse_glimmer"

output = /scratch/hongxuzhou/logs/llm_gen/train_full.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/train_full.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/train_full.$(ClusterId).log

request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 345600

queue 1
