universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/rsr_generation/natural_rsr_check/hpc/run_rsr.sh

# CPU only: about 2,900 real and 14,600 synthetic requests per model, with a
# 124M and a 160M model. Set GPT2_DIR to the directory the setup log found.
environment = "GPT2_DIR=/scratch/common_models/gpt2 OMP_NUM_THREADS=8"

output = /scratch/hongxuzhou/logs/rsr/run.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/rsr/run.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/rsr/run.$(ClusterId).log

request_CPUs   = 8
request_memory = 16G

+MaxWallTime = 14400

queue 1
