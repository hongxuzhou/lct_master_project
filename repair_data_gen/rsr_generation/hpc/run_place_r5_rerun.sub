universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/rsr_generation/hpc/run.sh

# Edge label, places, round 5 (2026-10-11), rerun: the 48 pilot documents (four
# strata, form x verb) plus the 2 round-5 documents with no reply
# (p01/d2312, p28/d3262), 2026-10-12. Documents of sample_train_place.tsv without a
# passing r4 item, the site given (sample_place_r5.py),
# prompts/place_r5/ (place-only §4.4, sha256 cf0cb470...). Results go to
# results/meta-models_Muse-Glimmer-30B.place_r5_rerun.tsv; resumable. About
# 20 min at 16 workers.
environment = "SAMPLE=samples/sample_place_r5_rerun.tsv TAG=place_r5_rerun DOCS=prompts/place_r5 WORKERS=16 TOOL_MODE=auto TOOL_PARSER=muse_glimmer REASONING_PARSER=muse_glimmer"

output = /scratch/hongxuzhou/logs/llm_gen/place_r5_rerun.$(ClusterId).out
error  = /scratch/hongxuzhou/logs/llm_gen/place_r5_rerun.$(ClusterId).err
log    = /scratch/hongxuzhou/logs/llm_gen/place_r5_rerun.$(ClusterId).log

request_CPUs   = 8
request_memory = 64G
request_GPUs   = 1
requirements = (GPUs_Capability >= 8.0) && (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 86400

queue 1
