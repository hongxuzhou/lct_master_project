universe = vanilla
initialdir = /nethome/honzhou

executable = /nethome/honzhou/thesis_zone/smoke_test/lst/run_smoke.sh
arguments = 2B repair $(ClusterId)-$(ProcId)

output = /scratch/hongxuzhou/logs/qwen35_lora_canary.2B.repair.$(ClusterId).$(ProcId).out
error  = /scratch/hongxuzhou/logs/qwen35_lora_canary.2B.repair.$(ClusterId).$(ProcId).err
log    = /scratch/hongxuzhou/logs/qwen35_lora_canary.$(ClusterId).log

request_cpus = 4
request_memory = 48G
request_gpus = 1
requirements = (TARGET.UidDomain == "coli.uni-saarland.de") && \
               (GPUs_Capability >= 8.0) && \
               (GPUs_GlobalMemoryMb >= 39000) && \
               (GPUs_GlobalMemoryMb <= 41000)

+MaxWallTime = 7200
notification = Never
should_transfer_files = NO

queue 1
